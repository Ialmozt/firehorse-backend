# Backup Configuration for Firehorse MVP
# PostgreSQL Only (No Supabase)
BACKUP_STRATEGY="2-layer"
BACKUP_RETENTION_DAYS=30

# Layer 1: Daily Database Snapshots (pg_dump)
DB_BACKUP_ENABLED=true
DB_RETENTION_DAYS=7

# PostgreSQL Connection
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="FirehorsePG2024"
DB_NAME="firehorse"

# Layer 2: Application Backup (Docker volumes + configs)
APP_BACKUP_ENABLED=true
APP_BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true
BACKUP_ENCRYPTION=true
BACKUP_ENCRYPTION_KEY="844de718562ac92d"

# RTO/RPO Targets
RTO_MINUTES=5
RPO_MINUTES=60

# Monitoring
BACKUP_HEALTH_CHECK_ENABLED=true
BACKUP_ALERT_EMAIL="ops@firehorse.com"
